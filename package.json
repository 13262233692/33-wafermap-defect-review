{
  "name": "wafermap-defect-review",
  "version": "1.0.0",
  "description": "Semiconductor Fab Yield Analysis - Wafermap Defect Review System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "webpack serve --mode development",
    "dev:electron": "wait-on http://localhost:9000 && electron .",
    "build": "npm run build:native && npm run build:renderer && npm run build:electron",
    "build:native": "cd native && cargo build --release",
    "build:renderer": "webpack --mode production",
    "build:electron": "electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "electron": "^28.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.161.2",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.1",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
